{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_AccountSettings": {
            "type": "panel",
            "label": "Google Settings",
            "items": {
                "_explanation": {
                    "type": "staticText",
                    "label": "labelAccountHint",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "googleUsername": {
                    "type": "text",
                    "label": "Username of ioBroker Google Account",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "googlePassword": {
                    "type": "password",
                    "label": "Password of ioBroker Google Account",
                    "visible": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "pollInterval": {
                    "type": "number",
                    "label": "Polling Interval (in seconds, at least 60 seconds)",
                    "default": 300,
                    "unit": "s",
                    "min": 60,
                    "max": 86400,
                    "step": 10,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                }
            }
        },
        "_LoginSettings": {
            "type": "panel",
            "label": "Login Settings",
            "items": {
                "_challengeHint": {
                    "type": "staticText",
                    "label": "labelChallengeHint",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "challengeTimeout": {
                    "type": "number",
                    "label": "Wait for confirmation (in seconds, 0 disables waiting)",
                    "default": 120,
                    "unit": "s",
                    "min": 0,
                    "max": 900,
                    "step": 10,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_remoteDebuggingHint": {
                    "type": "staticText",
                    "label": "labelRemoteDebuggingHint",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "remoteDebugging": {
                    "type": "checkbox",
                    "label": "Enable remote debugging of the login browser",
                    "default": false,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "remoteDebuggingPort": {
                    "type": "number",
                    "label": "Remote debugging port (localhost only)",
                    "default": 9222,
                    "min": 1024,
                    "max": 65535,
                    "hidden": "!data.remoteDebugging",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                }
            }
        },
        "_GeofencingSettings": {
            "type": "panel",
            "label": "Geofencing Settings",
            "items": {
                "placesInstance": {
                    "type": "instance",
                    "label": "Instance of iobroker.places to use",
                    "adapter": "places",
                    "allowDeactivate": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "fences": {
                    "type": "table",
                    "clone": false,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "label": "Fences, will create boolean states for each fence to indicate if user is within the fence",
                    "items": [
                        {
                            "type": "text",
                            "title": "Name of fence",
                            "width": "20%",
                            "attr": "name",
                            "sort": true,
                            "default": ""
                        },
                        {
                            "type": "number",
                            "title": "Latitude",
                            "width": "20%",
                            "attr": "latitude"
                        },
                        {
                            "type": "number",
                            "title": "Longitude",
                            "width": "20%",
                            "attr": "longitude"
                        },
                        {
                            "type": "number",
                            "title": "Radius (m)",
                            "width": "5%",
                            "attr": "radius",
                            "default": 100
                        },
                        {
                            "type": "selectSendTo",
                            "command": "getUsers",
                            "attr": "user",
                            "multiple": false,
                            "title": "User",
                            "width": "20%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "title": "ID of state",
                            "width": "15%",
                            "attr": "fenceId"
                        }
                    ]
                }
            }
        }
    }
}
