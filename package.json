{
  "name": "iobroker.google-sharedlocations2",
  "version": "0.4.0",
  "description": "Share your location with iobroker via google maps.",
  "author": {
    "name": "Garfonso",
    "email": "garfonso@mobo.info"
  },
  "contributors": [],
  "homepage": "https://github.com/Garfonso/ioBroker.google-sharedlocations2",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "google",
    "geofence",
    "gps",
    "position",
    "geo"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:Garfonso/ioBroker.google-sharedlocations2.git"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@iobroker/types": "^7.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.0 < 23",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "hooks:install": "git config core.hooksPath tools/git-hooks",
    "prepublishOnly": "npm run build",
    "check": "tsc --noEmit",
    "check:test": "tsc --noEmit -p tsconfig.test.json",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "npm run build && mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server",
    "lint": "eslint -c eslint.config.mjs src/",
    "lint:fix": "eslint -c eslint.config.mjs src/ --fix"
  },
  "bugs": {
    "url": "https://github.com/Garfonso/ioBroker.google-sharedlocations2/issues"
  },
  "readmeFilename": "README.md",
  "allowScripts": {
    "puppeteer@25.12.0": true
  }
}
