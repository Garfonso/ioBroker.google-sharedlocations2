// Root tsconfig to set the settings and power editor support for all TS files
{
    // To update the compilation target, install a different version of @tsconfig/node... and reference it here
    // https://github.com/tsconfig/bases#node-22-tsconfigjson
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        // do not compile anything, this file is just to configure type checking
        // TypeScript files are executed directly without transpilation
        "noEmit": true,

        // check JS files
        "allowJs": true,
        "checkJs": true,

        "noEmitOnError": true,
        "outDir": "./build/",
        "removeComments": false,

        // This is necessary for the automatic typing of the adapter config
        "resolveJsonModule": true,

        // If you want to disable the stricter type checks (not recommended), uncomment the following line
        // "strict": false,
        // And enable some of those features for more fine-grained control
        // "strictNullChecks": true,
        // "strictPropertyInitialization": true,
        // "strictBindCallApply": true,
        // "noImplicitAny": true,
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        // Uncomment this if you want the old behavior of catch variables being `any`
        // "useUnknownInCatchVariables": false,

        "sourceMap": true,
        "inlineSourceMap": false
    },
    // ts-node runs the mocha tests. Those need the mocha/chai globals, which the production config above
    // deliberately leaves out. Plain tsc ignores this section, so "npm run check" stays free of test types.
    "ts-node": {
        "compilerOptions": {
            // TypeScript 6 wants an explicit rootDir as soon as something is emitted (ts-node does, tsc --noEmit does not)
            "rootDir": ".",
            "types": [
                "node",
                "mocha",
                "chai"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules/**",
        "widgets/**",
        "src/**/*.test.ts",
        "test/**/*.ts"
    ]
}